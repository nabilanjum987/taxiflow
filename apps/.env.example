# ============================================================
# Admin Panel — apps/admin-panel/.env
# ============================================================
VITE_API_URL=http://localhost:3000/api/v1

# ============================================================
# Dispatcher Panel — apps/dispatcher-panel/.env
# ============================================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# ============================================================
# Super Admin — apps/super-admin/.env
# ============================================================
VITE_API_URL=http://localhost:3000/api/v1
# The internal TaxiFlow super-admin tenant ID (from seed output)
VITE_SUPER_TENANT_ID=paste-super-admin-tenant-id-here

# ============================================================
# Landing Site — apps/landing-site/.env.local
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Set this to the client's tenant ID
NEXT_PUBLIC_TENANT_ID=paste-client-tenant-id-here
