{
  "expo": {
    "name": "CityRide Driver",
    "slug": "cityride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taxiflow.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CityRide needs your location to show you to passengers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CityRide needs your location while driving to share with passengers.",
        "NSLocationAlwaysUsageDescription": "Location is needed when the app is in background during a trip.",
        "NSCameraUsageDescription": "To upload your documents and profile photo.",
        "NSPhotoLibraryUsageDescription": "To upload your documents and profile photo."
      },
      "backgroundModes": ["location", "fetch"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f59e0b"
      },
      "package": "com.taxiflow.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_TENANT_GOOGLE_MAPS_KEY"
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f59e0b",
          "sounds": ["./assets/notification.wav"]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CityRide Driver to use your location to share with passengers during trips.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
