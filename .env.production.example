# ============================================================
# TaxiFlow Production Environment Variables
# Copy to .env.production and fill all values
# NEVER commit this file to git
# ============================================================

# ─── APP ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://api.taxiflow.com
ADMIN_PANEL_URL=https://admin.taxiflow.com
FRONTEND_URL=https://admin.taxiflow.com

# ─── DATABASE ─────────────────────────────────────────────
POSTGRES_USER=taxiflow
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=taxiflow_prod
DATABASE_URL=postgresql://taxiflow:GENERATE_STRONG_PASSWORD_HERE@postgres:5432/taxiflow_prod

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT (generate with: openssl rand -base64 64) ─────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# ─── ENCRYPTION (generate with: openssl rand -hex 32) ─────
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ─── OUR STRIPE (subscription billing for our clients) ─────
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ─── STRIPE PRICE IDs (create in Stripe dashboard) ────────
STRIPE_PRICE_STARTER=price_REPLACE_WITH_STARTER_PRICE_ID
STRIPE_PRICE_BUSINESS=price_REPLACE_WITH_BUSINESS_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_REPLACE_WITH_ENTERPRISE_PRICE_ID

# ─── SENDGRID (our transactional email) ───────────────────
SENDGRID_API_KEY=SG.REPLACE_WITH_SENDGRID_API_KEY
EMAIL_FROM=noreply@taxiflow.com
EMAIL_FROM_NAME=TaxiFlow

# ─── FIREBASE (our push notification service account) ──────
# Paste the entire JSON as a single line (escape quotes)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"taxiflow-prod",...}

# ─── AWS S3 (document + image storage) ────────────────────
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET
AWS_S3_BUCKET=taxiflow-uploads
AWS_S3_REGION=eu-west-2

# ─── LOGGING ──────────────────────────────────────────────
LOG_LEVEL=info

# ─── SUPER ADMIN ──────────────────────────────────────────
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
