# ============================================================
# TaxiFlow Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ============================================================

# ─── APP ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ──────────────────────────────────────────────
DATABASE_URL=postgresql://taxiflow:password@localhost:5432/taxiflow_dev?schema=public

# ─── REDIS ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── ENCRYPTION ────────────────────────────────────────────
# Used to encrypt client API keys in database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ─── OUR OWN KEYS (Super admin operations only) ────────────
GOOGLE_MAPS_API_KEY=
SENDGRID_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=taxiflow-uploads
AWS_S3_REGION=eu-west-2
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── STRIPE (Our subscription billing only) ────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── CLIENT API KEYS ───────────────────────────────────────
# Client API keys are stored ENCRYPTED in database — NOT here

# ─── EMAIL ─────────────────────────────────────────────────
EMAIL_FROM=noreply@taxiflow.com
EMAIL_FROM_NAME=TaxiFlow

# ─── LOGGING ───────────────────────────────────────────────
LOG_LEVEL=debug
